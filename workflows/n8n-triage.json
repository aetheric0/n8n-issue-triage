    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nif (!item.promptText) {\n  throw new Error(\n    'promptText missing. Input keys: ' + Object.keys(item).join(', ')\n  );\n}\n\nconst requestBody = {\n  model: \"openai/gpt-oss-20b\",\n  messages: [\n    {\n      role: \"system\",\n      content: \"You are an issue triage classifier. Return ONLY valid JSON with exactly these fields: category (bug|feature|question), priority (high|medium|low), suggestedAction (one sentence). No markdown, no backticks, no explanation.\"\n    },\n    {\n      role: \"user\",\n      content: item.promptText\n    }\n  ],\n  temperature: 0.1,\n  response_format: { type: \"json_object\" }\n};\nreturn [{ json: { requestBody } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "6a21f7cb-05ed-4b80-8ca5-288daac03fb3",
      "name": "Build Groq Request"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => {\n  const raw = item.json.choices?.[0]?.message?.content;\n\n  if (!raw) {\n    return {\n      json: {\n        category: 'unknown',\n        priority: 'medium',\n        suggestedAction: 'Classification returned no content — manual review required',\n        parseError: 'empty content',\n        originalTitle: $('Extract Issue Text').item.json.issueTitle,\n        originalUrl: $('Extract Issue Text').item.json.issueUrl\n      }\n    };\n  }\n\n  // Strip markdown fences if the model added them despite instructions\n  const cleaned = raw.trim()\n    .replace(/^```json\\s*/i, '')\n    .replace(/^```\\s*/i, '')\n    .replace(/\\s*```$/, '');\n\n  let parsed;\n  try {\n    parsed = JSON.parse(cleaned);\n  } catch (e) {\n    return {\n      json: {\n        category: 'unknown',\n        priority: 'medium',\n        suggestedAction: 'Classification parse failed — manual review required',\n        parseError: e.message,\n        rawResponse: raw,\n        originalTitle: $('Extract Issue Text').item.json.issueTitle,\n        originalUrl: $('Extract Issue Text').item.json.issueUrl\n      }\n    };\n  }\n\n  return {\n    json: {\n      category: parsed.category || 'unknown',\n      priority: parsed.priority || 'medium',\n      suggestedAction: parsed.suggestedAction || 'Review manually',\n      originalTitle: $('Extract Issue Text').item.json.issueTitle,\n      originalUrl: $('Extract Issue Text').item.json.issueUrl\n    }\n  };\n});"
      },
