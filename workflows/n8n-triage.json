        "jsCode": "const items = $input.all();\nreturn items.map(item => {\n  const payload = item.json.body || item.json;\n  return {\n    json: {\n      issueTitle: payload.title || 'Untitled',\n      issueBody: payload.body || '',\n      issueUrl: payload.url || '',\n      promptText: `Title: ${payload.title}\\n\\nBody: ${payload.body}`\n    }\n  }\n})"
      },
